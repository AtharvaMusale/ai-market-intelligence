# Copy to .env and fill in. .env is git-ignored; never put real keys in this file.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
DUCKDB_PATH=data/market_intel.duckdb

# Required by SEC EDGAR fair-access rules: your name and a real contact email
SEC_USER_AGENT=
# Optional (default: market-intel)
PINECONE_INDEX_NAME=market-intel
